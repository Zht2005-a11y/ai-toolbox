# Agnes AI 配置（复制本文件为 .env 并填入你的 Key）
AGNES_API_KEY=在这里填入你的Key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-3.0-flash
PORT=3000

# 邮件发送（忘记密码功能用，可选）
# 默认兼容 Resend 的 POST /emails 接口，换成其他发信 API 同理
# 不配置时：重置验证码只打印到服务端日志、并在页面上回显，仅供自部署自测
MAIL_API_URL=https://api.resend.com/emails
MAIL_API_KEY=
MAIL_FROM=AI 工具箱 <onboarding@resend.dev>
